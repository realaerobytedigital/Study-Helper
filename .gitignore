* {
  box-sizing: border-box;
}

:root {
  --bg: #f4f7fb;
  --panel: #ffffff;
  --primary: #4f46e5;
  --primary-deep: #3b37c7;
  --accent: #dbeafe;
  --text: #101828;
  --muted: #667085;
  --success: #16a34a;
  --success-soft: #dcfce7;
  --warning: #f59e0b;
  --warning-soft: #fef3c7;
  --border: #e4e7ec;
  --shadow: 0 12px 30px rgba(17, 24, 39, 0.08);
}

html, body {
  margin: 0;
  min-height: 100%;
  background: linear-gradient(180deg, #eef4ff 0%, #f7f8fd 100%);
  color: var(--text);
  font-family: Inter, 'Segoe UI', sans-serif;
}

body {
  min-height: 100vh;
}

button, input, textarea, select {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

#root {
  min-height: 100vh;
}

.topbar,
.hero,
.auth-shell,
.dashboard-shell,
.study-shell {
  max-width: 1200px;
  margin: 0 auto;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 2rem;
}

.brand {
  font-size: 1.6rem;
  font-weight: 800;
  letter-spacing: -0.06em;
  color: var(--primary-deep);
}

.hero {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 2rem;
  align-items: center;
  padding: 4rem 2rem 2rem;
  min-height: calc(100vh - 90px);
}

.eyebrow {
  display: inline-flex;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: var(--accent);
  color: var(--primary);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.hero-copy h1 {
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 1.05;
  letter-spacing: -0.08em;
  margin: 1rem 0;
}

.hero-copy p {
  font-size: 1.15rem;
  line-height: 1.7;
  color: var(--muted);
  max-width: 640px;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

.primary-button,
.secondary-button,
.ghost-button,
.success-button,
.warning-button,
.nav-button {
  border-radius: 12px;
  transition: 180ms ease;
}

.primary-button,
.success-button,
.warning-button {
  padding: 0.9rem 1.2rem;
  font-weight: 700;
  color: white;
}

.primary-button {
  background: var(--primary);
}

.primary-button:hover {
  background: var(--primary-deep);
}

.secondary-button,
.ghost-button,
.nav-button {
  padding: 0.9rem 1.1rem;
  background: white;
  border: 1px solid var(--border);
  color: var(--text);
}

.ghost-button {
  background: transparent;
  border-color: var(--border);
}

.success-button {
  background: var(--success);
}

.warning-button {
  background: var(--warning);
}

.hero-card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.mini-card,
.score-card,
.stat-card,
.panel-card,
.auth-card,
.study-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(224, 232, 255, 0.8);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.mini-card,
.score-card {
  padding: 1.5rem;
}

.mini-card p,
.score-card span,
.stat-card span,
.profile-card span,
.tag {
  color: var(--muted);
}

.mini-card strong,
.score-card strong,
.stat-card strong {
  display: block;
  margin-top: 0.5rem;
  font-size: 1.7rem;
}

.auth-shell {
  display: grid;
  place-items: center;
  min-height: 100vh;
  padding: 2rem;
}

.auth-card {
  width: min(100%, 480px);
  padding: 2rem;
}

.auth-header h2 {
  margin: 0.6rem 0 1.2rem;
  font-size: 2rem;
}

.auth-form,
.stack-form,
.card-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

label {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-size: 0.95rem;
  font-weight: 600;
}

input,
textarea,
select {
  border: 1px solid var(--border);
  padding: 0.9rem 1rem;
  border-radius: 12px;
  background: white;
  color: var(--text);
}

.full-width {
  width: 100%;
}

.dashboard-shell {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  min-height: 100vh;
  padding: 2rem;
  gap: 2rem;
}

.sidebar {
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 1.5rem;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  margin: 1.5rem 0;
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #93c5fd);
  color: white;
  font-weight: 700;
}

.profile-card strong,
.profile-card span {
  display: block;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.nav-button {
  text-align: left;
}

.nav-button.active {
  background: var(--primary);
  color: white;
}

.main-panel {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.panel-header,
.card-header-row,
.study-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.panel-header h2,
.card-header-row h3,
.panel-card h3 {
  margin: 0.4rem 0 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.stat-card {
  padding: 1.25rem 1.5rem;
}

.content-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.panel-card {
  padding: 1.4rem;
}

.deck-summary {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}

.deck-summary h4 {
  margin: 0.5rem 0;
  font-size: 1.6rem;
}

.tag {
  display: inline-flex;
  padding: 0.35rem 0.6rem;
  border-radius: 999px;
  background: #edf4ff;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--primary);
}

.study-shell {
  display: grid;
  place-items: center;
  min-height: 100vh;
  padding: 2rem;
}

.study-card {
  width: min(100%, 760px);
  padding: 1.8rem;
}

.counter {
  color: var(--muted);
}

.flashcard {
  display: grid;
  gap: 1rem;
  margin: 1.5rem 0;
}

.flashcard-face {
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 1.6rem;
}

.flashcard-face span {
  display: inline-block;
  margin-bottom: 0.8rem;
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.flashcard-face h3 {
  margin: 0;
  font-size: clamp(1.5rem, 4vw, 2.4rem);
  line-height: 1.3;
}

.flashcard-face.answer {
  background: linear-gradient(135deg, #ecfdf5, #ffffff);
}

.study-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.empty-state {
  min-height: 100vh;
  display: grid;
  place-items: center;
  font-size: 1.2rem;
  color: var(--muted);
}

@media (max-width: 900px) {
  .hero,
  .content-grid,
  .dashboard-shell,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-shell {
    padding: 1rem;
  }

  .sidebar {
    padding: 1rem;
  }
}
